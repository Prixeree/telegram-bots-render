# Runtime Mode: "webhook" for Render, "local" for laptop polling
MODE=webhook

# Bot 1: Lead Hunter Bot (@leadhunter2834bot)
BOT1_TOKEN=YOUR_BOT1_TELEGRAM_TOKEN_HERE
BOT1_SECRET=your_random_secret_token_bot1_here

# Bot 2: Demo Website Generator Bot (@Websitedemo2489bot)
BOT2_TOKEN=YOUR_BOT2_TELEGRAM_TOKEN_HERE
BOT2_SECRET=your_random_secret_token_bot2_here

# External APIs
SERPAPI_KEY=your_serpapi_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
VERCEL_TOKEN=your_vercel_token_here
VERCEL_PROJECT=demo-websites

# Authorized Users (Comma-separated Telegram user IDs or usernames without @)
AUTHORIZED_USERS=8884232483,Piyush35567

# Supabase Postgres connection string (from Supabase -> Project Settings -> Database -> Connection URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Server Settings (Render populates PORT and RENDER_EXTERNAL_URL automatically)
PORT=8000
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com
